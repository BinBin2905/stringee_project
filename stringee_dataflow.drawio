m=4;" vertex="1" parent="1"><mxGeometry x="1270" y="370" width="460" height="50" as="geometry"/></mxCell><mxCell id="v40" value="&lt;b&gt;③ 200 OK · SCCO[]&lt;/b&gt;" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=open;dashed=1;dashPattern=4 4;fontSize=10;align=center;strokeColor=#388E3C;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="470" as="sourcePoint"/><mxPoint x="900" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v41" value="&lt;b&gt;buildScco(from, to, fromInternal=false, routedUser):&lt;/b&gt;&lt;br/&gt;[ {action:&amp;quot;record&amp;quot;, eventUrl, format:&amp;quot;mp3&amp;quot;},&lt;br/&gt;&amp;nbsp;&amp;nbsp;{action:&amp;quot;connect&amp;quot;,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;from:{type:&amp;quot;external&amp;quot;, number:caller#, alias:caller#},&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;to:{type:&amp;quot;internal&amp;quot;, number:routedUser, alias:routedUser},&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;peerToPeerCall:false} ]" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff8b8;strokeColor=#d4b95e;shadow=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="960" y="475" width="540" height="130" as="geometry"/></mxCell><mxCell id="v42" value="&lt;b&gt;④ incomingcall&lt;/b&gt; event (Web SDK)" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=classic;endFill=1;startSize=20;endSize=10;fontSize=10;align=center;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="640" as="sourcePoint"/><mxPoint x="2100" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v43" value="&lt;b&gt;⑤ call.answer()&lt;/b&gt;" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=open;dashed=1;dashPattern=4 4;fontSize=10;align=center;strokeColor=#388E3C;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2100" y="720" as="sourcePoint"/><mxPoint x="900" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v44" value="&lt;b&gt;⑥ POST event_url&lt;/b&gt; {call_status:&amp;quot;answered&amp;quot;, ...}" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=classic;endFill=1;startSize=20;endSize=10;fontSize=10;align=center;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="800" as="sourcePoint"/><mxPoint x="1500" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v45" value="&lt;b&gt;⑦ Media flow&lt;/b&gt; · RTP via Stringee (peerToPeerCall=false)" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=classic;startArrow=classic;strokeColor=#1976D2;strokeWidth=2;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="880" as="sourcePoint"/><mxPoint x="2100" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v46" value="&lt;b&gt;⑧ POST event_url&lt;/b&gt;&lt;br/&gt;{call_status:&amp;quot;ended&amp;quot;, duration, endCallCause, ...}" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=classic;endFill=1;startSize=20;endSize=10;fontSize=10;align=center;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="970" as="sourcePoint"/><mxPoint x="1500" y="970" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v47" value="Logic: &lt;code&gt;setUserFree(to.number)&lt;/code&gt;&lt;br/&gt;Type: &lt;b&gt;EventWebhookBody&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff8b8;strokeColor=#d4b95e;shadow=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1140" y="975" width="360" height="50" as="geometry"/></mxCell><mxCell id="v48" value="&lt;b&gt;⑨ POST record.eventUrl&lt;/b&gt;&lt;br/&gt;RecordCompletedEvent (recordingUrl, ...)" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=classic;endFill=1;startSize=20;endSize=10;fontSize=10;align=center;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="1080" as="sourcePoint"/><mxPoint x="1500" y="1080" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v49" value="&lt;b&gt;⚠️&lt;/b&gt; Cùng vấn đề như Page 1 — record event lọt vào event_url handler không có discriminator." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe0e0;strokeColor=#d05050;shadow=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1020" y="1085" width="480" height="60" as="geometry"/></mxCell><mxCell id="v50" value="&lt;b&gt;Biến thể phone-to-phone (forward):&lt;/b&gt; Step ③ trả SCCO với&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;to: {type:&amp;quot;external&amp;quot;, number:forwardPhone, alias:forwardPhone}&lt;/code&gt;&lt;br/&gt;Step ④ thay vì gọi Web SDK, Stringee dial PSTN tới &lt;code&gt;forwardPhone&lt;/code&gt; qua trunk SIP.&lt;br/&gt;&lt;b&gt;Lưu ý hiện tại&lt;/b&gt;: &lt;code&gt;buildScco&lt;/code&gt; với &lt;code&gt;routedUser=undefined&lt;/code&gt; AND &lt;code&gt;toIsNumber=true&lt;/code&gt; set &lt;code&gt;from.number=stringeeHotline&lt;/code&gt; — &lt;b&gt;SAI&lt;/b&gt; cho phone-to-phone (xem phân tích #2 turn trước)." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff8b8;strokeColor=#d4b95e;shadow=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="700" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. Outbound · Server-initiated REST callout" id="page-out-rest"><mxGraphModel dx="2400" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v51" value="&lt;b style='font-size:18px'&gt;3. Outbound — Server-initiated callout (Call API REST)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#555'&gt;Server chủ động gọi: campaign dialer, click-to-call, scheduled call. Repo route: &lt;code&gt;POST /admin/make-call&lt;/code&gt; → &lt;code&gt;/v1/call2/callout&lt;/code&gt;.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="80" as="geometry"/></mxCell><mxCell id="v52" value="Admin / Trigger&lt;br/&gt;&lt;span style='font-size:9px;font-weight:normal;color:#555'&gt;(client UI / cron)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="200" y="110" width="200" height="50" as="geometry"/></mxCell><mxCell id="v53" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#888;" vertex="1" parent="1"><mxGeometry x="299" y="160" width="2" height="1490" as="geometry"/></mxCell><mxCell id="v54" value="My Server&lt;br/&gt;&lt;span style='font-size:9px;font-weight:normal;color:#555'&gt;(server/routes/admin.ts)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="200" height="50" as="geometry"/></mxCell><mxCell id="v55" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#888;" vertex="1" parent="1"><mxGeometry x="899" y="160" width="2" height="1490" as="geometry"/></mxCell><mxCell id="v56" value="Stringee Cloud&lt;br/&gt;&lt;span style='font-size:9px;font-weight:normal;color:#555'&gt;(api.stringee.com)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1400" y="110" width="200" height="50" as="geometry"/></mxCell><mxCell id="v57" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#888;" vertex="1" parent="1"><mxGeometry x="1499" y="160" width="2" height="1490" as="geometry"/></mxCell><mxCell id="v58" value="Caller / Callee" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="2000" y="110" width="200" height="50" as="geometry"/></mxCell><mxCell id="v59" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#888;" vertex="1" parent="1"><mxGeometry x="2099" y="160" width="2" height="1490" as="geometry"/></mxCell><mxCell id="v60" value="&lt;b&gt;① POST /admin/make-call&lt;/b&gt;&lt;br/&gt;body: MakeCalloutRequest" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=classic;endFill=1;startSize=20;endSize=10;fontSize=10;align=center;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="200" as="sourcePoint"/><mxPoint x="900" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v61" value="&lt;b&gt;② POST /v1/call2/callout&lt;/b&gt;&lt;br/&gt;header: X-STRINGEE-AUTH: &amp;lt;JWT rest_api:true&amp;gt;&lt;br/&gt;body: MakeCalloutRequest" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=classic;endFill=1;startSize=20;endSize=10;fontSize=10;align=center;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="280" as="sourcePoint"/><mxPoint x="1500" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v62" value="&lt;b&gt;MakeCalloutRequest&lt;/b&gt; {&lt;br/&gt;&amp;nbsp;&amp;nbsp;from: Party,&lt;br/&gt;&amp;nbsp;&amp;nbsp;to: Party[],&lt;br/&gt;&amp;nbsp;&amp;nbsp;actions?: SccoAction[],   ← SCCO inline&lt;br/&gt;&amp;nbsp;&amp;nbsp;answer_url?: string&amp;nbsp;&amp;nbsp;← HOẶC URL trả SCCO&lt;br/&gt;}&lt;br/&gt;&lt;br/&gt;JWT header: &lt;code&gt;cty:&amp;quot;stringee-api;v=1&amp;quot;&lt;/code&gt; BẮT BUỘC" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff8b8;strokeColor=#d4b95e;shadow=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1520" y="250" width="460" height="130" as="geometry"/></mxCell><mxCell id="v63" value="&lt;b&gt;③ 200 OK&lt;/b&gt; · MakeCalloutResponse&lt;br/&gt;StringeeResponse&amp;lt;{callId?:string}&amp;gt;&lt;br/&gt;{r:0, message:&amp;quot;...&amp;quot;, data:{callId:&amp;quot;call-vn-...&amp;quot;}}" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=open;dashed=1;dashPattern=4 4;fontSize=10;align=center;strokeColor=#388E3C;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="440" as="sourcePoint"/><mxPoint x="900" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v64" value="&lt;b&gt;④ 200 OK · ProxyResult&lt;/b&gt;&lt;br/&gt;{status, body}" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=open;dashed=1;dashPattern=4 4;fontSize=10;align=center;strokeColor=#388E3C;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="550" as="sourcePoint"/><mxPoint x="300" y="550" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v65" value="&lt;b&gt;⑤ ring caller leg&lt;/b&gt;" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=classic;endFill=1;startSize=20;endSize=10;fontSize=10;align=center;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="630" as="sourcePoint"/><mxPoint x="2100" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v66" value="&lt;b&gt;Nhánh A — request có &lt;code&gt;actions&lt;/code&gt; inline&lt;/b&gt;: Stringee chạy luôn SCCO đó. Bỏ qua step ⑥/⑦.&lt;br/&gt;&lt;b&gt;Nhánh B — request có &lt;code&gt;answer_url&lt;/code&gt;&lt;/b&gt;: Stringee callback step ⑥/⑦ bên dưới." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff8b8;strokeColor=#d4b95e;shadow=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="650" y="710" width="700" height="60" as="geometry"/></mxCell><mxCell id="v67" value="&lt;b&gt;⑥ GET answer_url&lt;/b&gt; · AnswerUrlParamsAppCall" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=classic;endFill=1;startSize=20;endSize=10;fontSize=10;align=center;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="790" as="sourcePoint"/><mxPoint x="900" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v68" value="&lt;b&gt;⑦ 200 OK · SCCO[]&lt;/b&gt;" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=open;dashed=1;dashPattern=4 4;fontSize=10;align=center;strokeColor=#388E3C;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="870" as="sourcePoint"/><mxPoint x="1500" y="870" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v69" value="&lt;b&gt;⑧ connect callee&lt;/b&gt;" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=classic;endFill=1;startSize=20;endSize=10;fontSize=10;align=center;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="950" as="sourcePoint"/><mxPoint x="2100" y="950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v70" value="&lt;b&gt;⑨ POST event_url&lt;/b&gt; events&lt;br/&gt;(started → answered → ended)" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=classic;endFill=1;startSize=20;endSize=10;fontSize=10;align=center;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="1030" as="sourcePoint"/><mxPoint x="900" y="1030" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v71" value="&lt;b&gt;Mid-call control (server-initiated REST):&lt;/b&gt;" style="text;html=1;align=left;fontSize=11;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="700" height="22" as="geometry"/></mxCell><mxCell id="v72" value="&lt;b&gt;POST /v1/call2/putactions&lt;/b&gt; {callId, actions:SccoAction[]} → inject SCCO mới giữa cuộc gọi&lt;br/&gt;&lt;b&gt;POST /v1/call2/transfer&lt;/b&gt; TransferCallRequest {callId, fromUserId, to:Party} → chuyển sang user/số khác&lt;br/&gt;&lt;b&gt;POST /v1/call2/stop&lt;/b&gt; {callId} → kết thúc cưỡng bức&lt;br/&gt;&lt;b&gt;POST /v1/call2/adduser&lt;/b&gt; {callId, ...} → thêm vào conference&lt;br/&gt;&lt;b&gt;POST /v1/call2/setvideofloor&lt;/b&gt; {callId, ...} → ép video floor&lt;br/&gt;&lt;b&gt;POST /v1/user/sendcustommessage&lt;/b&gt; {to, msg} → tin nhắn custom đến user&lt;br/&gt;&lt;b&gt;GET /v1/call/log?version=2&amp;amp;limit=&amp;amp;sort_by=&amp;amp;search_after[]=&lt;/b&gt; → query history&lt;br/&gt;&lt;b&gt;GET /v1/call/recording/{recordId}&lt;/b&gt; → tải file ghi âm (binary stream)&lt;br/&gt;&lt;br/&gt;Tất cả map qua &lt;code&gt;server/src/routes/admin.ts&lt;/code&gt; table &lt;code&gt;ENDPOINTS&lt;/code&gt;." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff8b8;strokeColor=#d4b95e;shadow=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="1100" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. Inbound · PCC" id="page-in-pcc"><mxGraphModel dx="2400" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v73" value="&lt;b style='font-size:18px'&gt;4. Inbound — PCC (Programmable Contact Center)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#555'&gt;PCC-enabled Number có &lt;code&gt;answer_url&lt;/code&gt; CỐ ĐỊNH trỏ về Stringee PCC engine (&lt;code&gt;http://v2.stringee.com:8282/answer_url&lt;/code&gt;). Server bạn KHÔNG trả SCCO cho luồng này.&lt;br/&gt;Server tham gia qua 4 webhook: &lt;code&gt;get_customer_info_url&lt;/code&gt;, queue's &lt;code&gt;get_list_agents_url&lt;/code&gt;, &lt;code&gt;event_url&lt;/code&gt;, &lt;code&gt;callout_answer_url&lt;/code&gt;.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2000" height="100" as="geometry"/></mxCell><mxCell id="v74" value="PSTN Customer" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="200" y="130" width="200" height="50" as="geometry"/></mxCell><mxCell id="v75" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#888;" vertex="1" parent="1"><mxGeometry x="299" y="180" width="2" height="1770" as="geometry"/></mxCell><mxCell id="v76" value="Stringee PCC engine&lt;br/&gt;&lt;span style='font-size:9px;font-weight:normal;color:#555'&gt;(IVR + ACD built-in)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="800" y="130" width="200" height="50" as="geometry"/></mxCell><mxCell id="v77" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#888;" vertex="1" parent="1"><mxGeometry x="899" y="180" width="2" height="1770" as="geometry"/></mxCell><mxCell id="v78" value="My Server&lt;br/&gt;&lt;span style='font-size:9px;font-weight:normal;color:#555'&gt;(pcc-server/routes/webhooks.ts)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1400" y="130" width="200" height="50" as="geometry"/></mxCell><mxCell id="v79" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#888;" vertex="1" parent="1"><mxGeometry x="1499" y="180" width="2" height="1770" as="geometry"/></mxCell><mxCell id="v80" value="Agent App&lt;br/&gt;&lt;span style='font-size:9px;font-weight:normal;color:#555'&gt;(pcc-client softphone)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="2000" y="130" width="200" height="50" as="geometry"/></mxCell><mxCell id="v81" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#888;" vertex="1" parent="1"><mxGeometry x="2099" y="180" width="2" height="1770" as="geometry"/></mxCell><mxCell id="v82" value="&lt;b&gt;① dial PCC Number&lt;/b&gt;" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=classic;endFill=1;startSize=20;endSize=10;fontSize=10;align=center;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="220" as="sourcePoint"/><mxPoint x="900" y="220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v83" value="Stringee PCC tự xử lý answer_url&lt;br/&gt;(URL fixed: v2.stringee.com:8282/answer_url)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff8b8;strokeColor=#d4b95e;shadow=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="700" y="300" width="400" height="40" as="geometry"/></mxCell><mxCell id="v84" value="&lt;b&gt;② GET get_customer_info_url&lt;/b&gt;&lt;br/&gt;?from=CUST#&amp;amp;to=PCC#&amp;amp;project=ID" style="html=1;rounded=0;edgeStyle=none;curved=0;endArrow=classic;endFill=1;startSize=20;endSize=10;fontSize=10;align=center;verticalAlign=middle;" edge="1" parent="1"><mxGeometry relativ